# Admin panel password (for updating iCal links)
ADMIN_PASSWORD=your-secure-password-here

# Base path only if the site is deployed under a subpath.
NEXT_PUBLIC_BASE_PATH=/3-amici-suites

# Public site URL (used for metadataBase, canonical URLs, sitemap)
NEXT_PUBLIC_SITE_URL=https://3amicisuites.it

# Contact form provider: resend | formspree
CONTACT_EMAIL_PROVIDER=resend

# Public client-side fallback only if you need static hosting
NEXT_PUBLIC_CONTACT_PROVIDER=resend
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Resend setup
RESEND_API_KEY=re_XXX...XXXX
CONTACT_FROM_EMAIL=3 Amici Suites <noreply@3amicisuites.it>
CONTACT_TO_EMAIL=info@3amicisuites.it

# Optional Formspree fallback
FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
